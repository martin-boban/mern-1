Exercise 2 — Working with HTML5 Forms and Media Elements

<!DOCTYPE html>
<html>
<head>
  <title>HTML5 Forms and Media</title>
</head>
<body>
  <h1>HTML5 Forms and Media Elements</h1>

  <!-- Form -->
  <h2>Registration Form</h2>
  <form>
    <label>Name: <input type="text" placeholder="Enter name"></label><br><br>
    <label>Email: <input type="email" placeholder="Enter email"></label><br><br>
    <label>Age: <input type="number" min="1" max="100"></label><br><br>
    <label>DOB: <input type="date"></label><br><br>
    <input type="submit" value="Submit">
  </form>

  <!-- Media -->
  <h2>Media Elements</h2>
  <img src="https://via.placeholder.com/200" alt="Sample Image"><br><br>

  <video width="300" controls>
    <source src="sample.mp4" type="video/mp4">
    Your browser does not support video.
  </video><br><br>

  <audio controls>
    <source src="sample.mp3" type="audio/mpeg">
    Your browser does not support audio.
  </audio>
</body>
</html>

