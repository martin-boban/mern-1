      padding: 10px;
    }
    nav a {
      color: white;
      margin: 0 15px;
      text-decoration: none;
    }
    .content {
      padding: 20px;
      background-color: white;
      margin: 20px;
      border-radius: 8px;
    }
    footer {
      background-color: #333;
